{
  "name": "upande-packhouse",
  "main": "expo-router/entry",
  "version": "1.2.1",
  "scripts": {
    "start": "expo start --go --port 8088",
    "start:dev": "APP_VARIANT=development expo start --dev-client --port 8088",
    "start:clear": "expo start --go --port 8088 --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --go --android --port 8088",
    "build:dev": "eas build -p android --profile development",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --watchAll",
    "test:ci": "jest --ci",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "npm run prebuild && cd android && ./gradlew assembleRelease",
    "version:next": "node scripts/version.mjs",
    "version:apply": "node scripts/version.mjs --apply",
    "version:notes": "node scripts/version.mjs --notes",
    "ota:build": "node scripts/publish-ota.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "axios": "^1.15.2",
    "date-fns": "^4.1.0",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-network": "~58.0.4",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.74.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
