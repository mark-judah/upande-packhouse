{
  "expo": {
    "name": "Upande Packhouse",
    "slug": "upande-packhouse",
    "owner": "markjk",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/upande_logo.png",
    "scheme": "upandepackhouse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upande.packhouse",
      "infoPlist": {
        "NSCameraUsageDescription": "We use the camera to scan barcodes.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.upande.packhouse",
      "versionCode": 5001,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/upande_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/upande_logo.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "./plugins/withBuildTuning",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "We use the camera to scan barcodes."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/upande_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "81077d75-b922-4416-8e29-f0291f15e8a0"
      }
    },
    "runtimeVersion": "1.0",
    "updates": {
      "url": "https://u.expo.dev/81077d75-b922-4416-8e29-f0291f15e8a0",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
